{
  "name": "outside",
  "version": "2.0.0",
  "description": "Kelvine's SleepOutside outdoor gear storefront",
  "main": "main.js",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "concurrently -k -s first \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "vite build --emptyOutDir",
    "preview": "vite preview",
    "lint": "eslint *.js src/**/*.js",
    "format": "prettier --ignore-path ./.gitignore --write \"./**/*.{html,json,js,ts,css}\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "author": "Kelvine",
  "license": "ISC",
  "devDependencies": {
    "@babel/preset-env": "^7.29.14",
    "concurrently": "^10.0.7",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "vite": "^5.4.7"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "browserslist": [
    "last 3 and_chr versions",
    "last 3 chrome versions",
    "last 3 opera versions",
    "last 3 ios_saf versions",
    "last 3 safari versions"
  ],
  "jest": {
    "testRegex": ".*\\.test\\.mjs$"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
